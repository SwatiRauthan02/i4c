# invoke rewrite engine
RewriteEngine On
RewriteBase /final

#Options -Indexes
#<IfModule mod_negotiation.c>
#	Options -MultiViews
#</IfModule>

# Create pretty URLs
#DirectorySlash Off

 #RewriteCond %{REQUEST_FILENAME}.html -f
 #RewriteRule ^ %{REQUEST_URI}.html [NC,L]
# End: Create pretty URLs

# Specific redirections
#RewriteRule ^index\.html$ / [L,R=301]
# RewriteCond %{QUERY_STRING} ^$
 #RewriteRule ^index\.php$ index_php.html [L,R=301,QSD]
 #RewriteCond %{QUERY_STRING} ^goto=about_us$
 #RewriteRule ^index\.php$ index_goto-about_us.html [L,R=301,QSD]
#RewriteCond %{QUERY_STRING} ^goto=contact_us$
 #RewriteRule ^index\.php$ index_goto-contact_us.html [L,R=301,QSD]
 #RewriteCond %{QUERY_STRING} ^msg=grid_score$
 #RewriteRule ^login\.php$ login_msg-grid_score.html [L,R=301,QSD]
 #RewriteCond %{QUERY_STRING} ^msg=monitor_login$
 #RewriteRule ^login\.php$ login_msg-monitor_login.html [L,R=301,QSD]
 #RewriteCond %{QUERY_STRING} ^msg=portfolio_en$
 #RewriteRule ^login\.php$ login_msg-portfolio_en.html [L,R=301,QSD]
 #RewriteCond %{QUERY_STRING} ^msg=portfolio_th$
 #RewriteRule ^login\.php$ login_msg-portfolio_th.html [L,R=301,QSD]
#RewriteRule ^Nufocus/PARS/PARS\sPricing\.htm$ Nufocus/PARS/PARSPricing.html [L,R=301,QSD]
#RewriteRule ^Nufocus/Public/PARS\sMac\sUpgrader\.sit$ Nufocus/Public/PARSMacUpgrader.html [L,R=301,QSD]
#RewriteRule ^Nufocus/Public/Macintosh\sPARS\sManual\.sit$ Nufocus/Public/MacintoshPARSManual.html [L,R=301,QSD]

# Redirect all extensions to html
#RewriteCond %{QUERY_STRING} ^$
#RewriteRule ^(.*)\.shtml$ $1.html [L,NC,R=301]
#RewriteCond %{QUERY_STRING} ^$
#RewriteRule ^(.*)\.phtml$ $1.html [L,NC,R=301]
#RewriteCond %{QUERY_STRING} ^$
#RewriteRule ^(.*)\.jhtml$ $1.html [L,NC,R=301]
#RewriteCond %{QUERY_STRING} ^$
#RewriteRule ^(.*)\.htm$ $1.html [L,NC,R=301]
#RewriteCond %{QUERY_STRING} ^$
# RewriteRule ^(.*)\.php$ $1.html [L,NC,R=301]
#RewriteCond %{QUERY_STRING} ^$
#RewriteRule ^(.*)\.aspx$ $1.html [L,NC,R=301]
#RewriteCond %{QUERY_STRING} ^$
#RewriteRule ^(.*)\.asp$ $1.html [L,NC,R=301]
#RewriteCond %{QUERY_STRING} ^$
#RewriteRule ^(.*)\.jsp$ $1.html [L,NC,R=301]
#RewriteCond %{QUERY_STRING} ^$
#RewriteRule ^(.*)\.apk$ $1.html [L,NC,R=301]
# End: Redirect all extensions to html
